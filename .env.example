# =============================================================================
# Amazon Web Services (REQUIRED)
# Usado por: Bedrock (LLM + Embeddings), Transcribe (STT), Polly (TTS)
# =============================================================================

AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1

# =============================================================================
# Amazon Bedrock - LLM Configuration
# =============================================================================

# Modelo LLM (Claude 3.5 Haiku — recomendado: rápido y económico)
BEDROCK_LLM_MODEL=us.anthropic.claude-3-5-haiku-20241022-v1:0

# Parámetros de generación
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# =============================================================================
# Amazon Bedrock - Embedding Configuration
# =============================================================================

# Modelo de embeddings (Titan V2 — 1024 dims, multilingüe)
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# Dimensión del embedding (Titan V2 soporta: 256 / 512 / 1024)
EMBEDDING_DIM=1024

# =============================================================================
# Amazon Polly TTS
# =============================================================================

POLLY_VOICE=Lupe
POLLY_ENGINE=neural
POLLY_LANGUAGE=es-US

# =============================================================================
# FAQ System Configuration
# =============================================================================

FAQ_HIGH_THRESHOLD=0.75      # >= 75%: Strong match - FAQ only
FAQ_MEDIUM_THRESHOLD=0.65    # >= 65%: Medium match - FAQs + docs

FAQ_TOP_K=5
FAQ_NUM_HIGH=3
FAQ_NUM_MEDIUM=2
FAQ_DOCS_MEDIUM=2

FAQ_TEMP_FAQ_ONLY=0.1
FAQ_TEMP_HYBRID=0.2
FAQ_TEMP_DOCS_ONLY=0.3

# =============================================================================
# Document Retrieval Configuration
# =============================================================================

RETRIEVAL_TOP_K=3
RETRIEVAL_MIN_SIMILARITY=0.3
RETRIEVAL_MAX_DOCS=10

# =============================================================================
# ChromaDB Configuration
# =============================================================================

CHROMA_STORAGE_PATH=data/chroma
CHROMA_COLLECTION=documents
CHROMA_SIMILARITY=cosine

# =============================================================================
# Amazon S3 — Documentos y ChromaDB
# =============================================================================

S3_BUCKET_NAME=voae-chatbot-data
S3_DOCS_PREFIX=docs/          # Prefijo donde viven los archivos .md
S3_CHROMA_PREFIX=chroma/      # Prefijo donde se almacena chroma.sqlite3

# =============================================================================
# Document Ingestion Configuration
# =============================================================================

ENABLE_CHUNKING=false
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# =============================================================================
# Chatbot Configuration
# =============================================================================

CHATBOT_MAX_HISTORY=10
CHATBOT_ENABLE_FAQ=true

# =============================================================================
# API Configuration
# =============================================================================

API_HOST=127.0.0.1
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
API_REQUEST_TIMEOUT=30
API_LOG_LEVEL=info
